# Local test bot
BOT_TOKEN=replace_with_your_test_bot_token
OWNER_ID=1089429471

# Keep test data isolated from production data. Leave DATABASE_URL and
# NEON_DATABASE_URL unset when using this local configuration.
DB_PATH=.local/test_bot_database.db

# Production/Render only. Startup restore is enabled by default; this explicit
# value documents the required recovery behavior.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_STARTUP_BOOTSTRAP_NEON=1

# Existing event-driven sync policy (unchanged).
DB_SYNC_MIN_ACTIVITY_MESSAGES=100
DB_SYNC_MIN_INTERVAL=18000
DB_SYNC_RETRY_INTERVAL=600
